{
	"compilerOptions": {
		"target": "ESNext",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"strict": true,
		"skipLibCheck": true,
		"lib": ["ESNext"],
		"jsx": "react-jsx",
		"jsxImportSource": "hono/jsx",
		"types": ["./worker-configuration.d.ts", "node"]
	},
	"include": [
		"src/**/*",
		"algo-account.ts",
		"test-algo.ts",
		"worker-configuration.d.ts"
	],
	"exclude": ["node_modules", "dist", ".wrangler"]
}
